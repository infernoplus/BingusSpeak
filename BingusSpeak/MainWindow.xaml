<Window x:Class="BingusSpeak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BingusSpeak"
        mc:Ignorable="d"
        Title="Bingus Speak" Height="900" Width="1400">
    <Window.Resources>
        <!-- Custom Template to change the Expander's Arrow to a traditional Plus/Minus -->
        <ControlTemplate x:Key="ClassicPlusMinusExpander" TargetType="{x:Type Expander}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Panel (Folder Node) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                    <!-- ToggleButton representing the +/- Box -->
                    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Width="13" Height="13" Margin="0,0,6,0" Focusable="False" Background="White">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border BorderBrush="#FFA0A0A0" BorderThickness="1" Background="{TemplateBinding Background}">
                                    <!-- Dynamic content switcher for + / - -->
                                    <TextBlock x:Name="Sign" Text="+" FontSize="9" FontWeight="Bold" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Sign" Property="Text" Value="-" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- The Actual Folder Text -->
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Children Panel (Files list) plus the Tree Line -->
                <Grid Grid.Row="1" x:Name="ExpandSite" Visibility="Collapsed" Margin="6,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- This thin border acts as the vertical connecting hierarchy line -->
                    <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1,0,0,0" Margin="0,2,0,5" />

                    <!-- The actual file items layout container -->
                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch"/>
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    
    <DockPanel>
        <!-- Standard Top Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <!-- File Dropdown -->
            <MenuItem Header="_File">
                <MenuItem Header="_Load" Click="Load_Click" InputGestureText="Ctrl+L" />
                <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>

            <!-- Edit Dropdown -->
            <MenuItem Header="_Edit">
                <MenuItem Header="Cu_t" Command="Cut" />
                <MenuItem Header="_Copy" Command="Copy" />
                <MenuItem Header="_Paste" Command="Paste" />
            </MenuItem>

            <!-- View Dropdown -->
            <MenuItem Header="_View">
                <MenuItem Header="Collapse All" Click="Collapse_Click" />
                <MenuItem Header="Expand All" Click="Expand_Click" />
            </MenuItem>

            <!-- Split Dropdown -->
            <MenuItem Header="_Split">
                <MenuItem Header="Split by NPC" Click="SplitNpc_Click" />
            </MenuItem>
        </Menu>

        <!-- Main Content Grid -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left column for the list (fixed/resizable width) -->
                <ColumnDefinition Width="500" />
                <!-- Splitter column so users can resize the panels -->
                <ColumnDefinition Width="Auto" />
                <!-- Right column for the text areas (takes up remaining space) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. Left Side: Basic List -->
            <!-- Main ListBox -->
            <ListBox x:Name="DialogList" Margin="10" BorderThickness="0" Background="Transparent" SelectionChanged="DialogList_SelectionChanged">
                <!-- File Look & Feel -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Horizontal connector node line for each file -->
                            <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="0,0,0,1" Height="1" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <!-- File item text -->
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{Binding TextColor}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <!-- Group Layout Hierarchy Settings -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <!-- Apply our custom styled expander -->
                                            <Expander Header="{Binding Name}" 
                                                  Template="{StaticResource ClassicPlusMinusExpander}"
                                                  IsExpanded="True" 
                                                  FontWeight="Normal" 
                                                  FontSize="12"
                                                  Foreground="#FF333333"
                                                  Margin="0,0,0,2">
                                                <ItemsPresenter />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>

            <!-- Optional: Draggable splitter between left and right sides -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#FFECECEC" />

            <!-- Right Side Layout container -->
            <DockPanel Grid.Column="2" Margin="5">
                <!-- 3. Bottom: Non-editable information text -->
                <TextBlock DockPanel.Dock="Bottom" 
                           Height="400"
                           Text="" 
                           Padding="5" 
                           Background="#FFF0F0F0" 
                           TextWrapping="Wrap"
                           Foreground="#FF555555">
                    <Run x:Name="EditorInfo" FontSize="22" FontWeight="Normal"></Run>
                    <Run x:Name="NpcInfo" FontSize="16" FontWeight="Normal"></Run>
                </TextBlock>

                <!-- 2. Top/Center: Editable text area -->
                <TextBox x:Name="EditorText"
                         AcceptsReturn="True" 
                         TextWrapping="Wrap" 
                         FontSize="18"
                         Margin="0,0,0,5" 
                         VerticalScrollBarVisibility="Auto"
                         LostFocus="EditorText_LostFocus"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
